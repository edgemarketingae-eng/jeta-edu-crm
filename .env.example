# ---- Copy to .env and fill in. Never commit .env. ----

# First start only: creates the Owner account (password 10+ characters).
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=change-this-to-a-long-password
OWNER_NAME=Owner

# Leave false on a real server (true seeds demo data with public passwords).
SEED_DEMO=false

PORT=3000
# DB_PATH=/var/lib/jeta-crm/jeta-crm.db     # PM2/systemd installs
# BACKUP_DIR=/var/backups/jeta-crm
TRUST_PROXY=true                            # behind Nginx

# REQUIRED on production: encrypts bank details, KYC documents and 2FA secrets.
# Generate once with: openssl rand -hex 32   – back it up safely; losing it means losing that data.
ENCRYPTION_KEY=

# Public address of this CRM (used in teacher class-confirmation links sent on WhatsApp)
PUBLIC_URL=https://crm.yourdomain.com

BRAND_NAME=Jeta Edu
INR_PER_AED=22.7

# Lead webhook for website / Meta / Google forms: POST /api/webhooks/lead?key=...
# Generate with: openssl rand -hex 24
WEBHOOK_KEY=

# Cloud telephony provider webhook: POST /api/webhooks/telephony?key=...
TELEPHONY_KEY=

# Google Workspace (Jeta-owned Meet links + Meet attendance). See DEPLOY.md section 8.
# GOOGLE_SERVICE_ACCOUNT_JSON=/opt/jeta-crm/google-key.json
# GOOGLE_IMPERSONATE=classes@jetaedu.com
# GOOGLE_ADMIN_IMPERSONATE=admin@jetaedu.com
# GOOGLE_CALENDAR_ID=primary

# WhatsApp Business API + email (wire your provider in src/notify.js)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SMTP_URL=

# AUTOMATION=off   # only if you run a second instance against the same DB
